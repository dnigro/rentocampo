# Supabase public configuration (required for build and runtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical application URL used in email notifications
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only credentials (never use NEXT_PUBLIC_ prefixes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=RentoCampo <no-reply@rentocampo.com>
RESEND_REGISTRATION_SECRET=your-long-random-secret
