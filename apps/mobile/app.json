{
  "expo": {
    "name": "RentoCampo",
    "slug": "rentocampo",
    "scheme": "rentocampo",
    "version": "0.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rentocampo.app"
    },
    "android": {
      "package": "com.rentocampo.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "environment": "prototype"
    },
    "description": "RentoCampo Lite para Android, prueba interna: marca oficial RC, inicio, campos, servicios y perfil.",
    "icon": "./assets/icon.png"
  }
}
