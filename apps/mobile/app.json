{
  "expo": {
    "name": "RentoCampo",
    "slug": "rentocampo",
    "scheme": "rentocampo",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rentocampo.app"
    },
    "android": {
      "package": "com.rentocampo.app",
      "versionCode": 2
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "environment": "prototype"
    },
    "description": "RentoCampo App Lite para Android: inicio, campos, servicios y perfil. Prueba interna con catalogo en linea."
  }
}
