{
  "expo": {
    "name": "RentoCampo",
    "slug": "rentocampo",
    "scheme": "rentocampo",
    "version": "0.2.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rentocampo.app",
      "buildNumber": "1",
      "deploymentTarget": "15.1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rentocampo.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "environment": "prototype"
    },
    "description": "RentoCampo Lite para Android y iOS. Plataforma rural sin intermediarios, con Campos, Servicios y Perfil.",
    "icon": "./assets/icon.png"
  }
}
